    },
    "financing_requests": {
      "schema": "object",
      "description": "Vehicle financing applications"
    },
    "insurance_requests": {
      "schema": "object",
      "description": "Insurance quote requests"
    },
    "inspection_requests": {
      "schema": "object",
      "description": "Vehicle inspection bookings"
    },
    "banners": {
      "schema": "object",
      "description": "Promotional banners"
    },
    "popular_styles": {
      "schema": "PopularStyle",
      "description": "Collection of Carvana-style popular vehicle body types"
    },
    "saved_searches": {
      "schema": "SavedSearch",
      "description": "Collection of user saved searches and watch parameters"
    },
    "ads_configurations": {
      "schema": "CustomAd",
      "description": "Collection of dynamic banner and interactive ads configured by administrators"
    },
    "reels": {
      "schema": "Reel",
      "description": "TikTok-style video reels linked to active vehicle listings"
    },
    "reels_comments": {
      "schema": "ReelComment",
