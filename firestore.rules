rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // Global Safety Net
    // ---------------------------------------------------------
    match /{document=**} { allow read, write: if false; }

    // ---------------------------------------------------------
    // Global Helpers
    // ---------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() { 
      return isSignedIn() && request.auth.token.email_verified == true && (
        request.auth.token.email == 'redspotsproduction@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    // Verified User: Identity or business verified (server-set claim or server-set document field), NOT verificationLevel >= 1
    function isVerifiedUser() {
      return isSignedIn() && (
        request.auth.token.isVerified == true ||
        request.auth.token.identity_verified == true ||
        request.auth.token.business_verified == true ||
        (request.auth.token.email_verified == true && request.auth.token.email == 'redspotsproduction@gmail.com') ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.identity_status == 'verified' ||
          get(/databases/$(database)/documents/users/$(request.auth.uid)).data.business_status == 'approved')) ||
        isAdmin()
      );
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ---------------------------------------------------------
    // 1. Public Profiles (Sanitized, non-PII, public display)
    // The owner may write ONLY displayName and photoURL.
    // badge, badgeType, rating, agency, and verification-related fields
    // are written ONLY by admin or Cloud Function.
    // ---------------------------------------------------------
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && incoming().keys().hasOnly(['displayName', 'photoURL']))
      );
      allow update: if isSignedIn() && (
        isAdmin() ||
        (request.auth.uid == userId && incoming().diff(existing()).affectedKeys().hasOnly(['displayName', 'photoURL']))
      );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // 2. Users & Private Profiles
    // Role must equal 'user'. Trust/risk scores, IP history, and status
    // are NOT user-writable (server-written only).
    // ---------------------------------------------------------
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'status', 'role']) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.status in ['active', 'suspended', 'banned', 'pending'] &&
             data.role == 'user' &&
             (!('isVerified' in data) || data.isVerified == false) &&
             (!('verificationLevel' in data) || data.verificationLevel == 0) &&
             (!('isPhoneVerified' in data) || data.isPhoneVerified == false) &&
             (!('isEmailVerified' in data) || data.isEmailVerified == false) &&
             (!('isOtpVerified' in data) || data.isOtpVerified == false) &&
             (!('identity_status' in data) || data.identity_status != 'verified') &&
             (!('verified_badge_type' in data) || data.verified_badge_type == 'none') &&
             (!('trustScore' in data)) &&
             (!('riskScore' in data)) &&
             (!('riskLevel' in data)) &&
             (!('suspiciousActivityCount' in data)) &&
             (!('lastKnownIp' in data)) &&
             (!('ipHistory' in data));
    }

    match /users/{userId} {
      // Readable by owner and admin only (PII Isolation)
      allow read: if isOwner(userId) || isAdmin(); 
      allow create: if isSignedIn() && isValidUser(incoming()) && userId == request.auth.uid;
      
      // Action: Profile Update (Restricted non-sensitive profile customization)
      function isProfileUpdate() {
        return incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'username',
          'isOnline', 'lastSeen', 'notificationSettings', 'dob', 
          'nationality', 'gender', 'updatedAt',
          'themePreference', 'bio', 'city', 'address', 'agencyName', 'agencyLicense'
        ]);
      }

      // Action: Onboarding Initial State Transition with Strict Field Allowlist
      // status is NOT user-writable (server-written only).
      function isTransitioningOnboarding() {
        return (
          !('onboardingCompletedAt' in existing()) || 
          (existing().isPendingOnboarding == true)
        ) && 
        incoming().role == 'user' &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'username', 'photoURL', 'accountType', 'agencyName', 
          'agencyLicense', 'city', 'address', 'operatingSystem', 'browser', 
          'device', 'registrationSource', 'lastLoginAt', 'isOnline', 'lastSeen', 
          'isPendingOnboarding', 'onboardingCompletedAt', 'updatedAt',
          'role', 'bio'
        ]);
      }

      // Constraints enforcing that normal users cannot write identity_status='verified', verified_badge_type, role, verification fields, status, trust/risk scores or IP history
      function isSafeUserSelfUpdate() {
        return isOwner(userId) &&
          (!('status' in incoming()) || incoming().status == existing().status) &&
          (!('role' in incoming()) || incoming().role == existing().role) &&
          (!('role' in incoming()) || incoming().role != 'admin' || existing().role == 'admin') &&
          (!('isVerified' in incoming()) || incoming().isVerified == existing().isVerified) &&
          (!('identity_status' in incoming()) || incoming().identity_status == existing().identity_status) &&
          (!('verificationLevel' in incoming()) || incoming().verificationLevel == existing().verificationLevel) &&
          (!('isPhoneVerified' in incoming()) || incoming().isPhoneVerified == existing().isPhoneVerified) &&
          (!('isEmailVerified' in incoming()) || incoming().isEmailVerified == existing().isEmailVerified) &&
          (!('isOtpVerified' in incoming()) || incoming().isOtpVerified == existing().isOtpVerified) &&
          (!('verified_badge_type' in incoming()) || incoming().verified_badge_type == existing().verified_badge_type) &&
          (!('badgeType' in incoming()) || incoming().badgeType == existing().badgeType) &&
          (!('trustScore' in incoming()) || incoming().trustScore == existing().trustScore) &&
          (!('riskScore' in incoming()) || incoming().riskScore == existing().riskScore) &&
          (!('riskLevel' in incoming()) || incoming().riskLevel == existing().riskLevel) &&
          (!('suspiciousActivityCount' in incoming()) || incoming().suspiciousActivityCount == existing().suspiciousActivityCount) &&
          (!('lastKnownIp' in incoming()) || incoming().lastKnownIp == existing().lastKnownIp) &&
          (!('ipHistory' in incoming()) || incoming().ipHistory == existing().ipHistory);
      }

      allow update: if isSignedIn() && (
        (isOwner(userId) && 
         (
           isProfileUpdate() ||
           isTransitioningOnboarding()
         ) &&
         isSafeUserSelfUpdate()
        ) || isAdmin()
      );
      
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /payment_methods/{methodId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ---------------------------------------------------------
    // 3. Verification Requests
    // ---------------------------------------------------------
    match /verification_requests/{requestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // 4. Properties & Listings
    // create allowlist: hasOnly: id, seller, status 'pending', price, createdAt, content fields.
    // Block title_deed_status, titleDeedStatus, title_deed_verified, isTitleDeedVerified, reference_id, views, favorites, isAuctionVerified at create.
    // Owners may change status only: active<->inactive, active->sold, expired->active, and set last_confirmed_active and reactivated_at.
    // ---------------------------------------------------------
    function isValidPropertyCreate(data) {
      return data.keys().hasOnly([
               'id', 'seller', 'status', 'price', 'createdAt',
               'title', 'description', 'photos', 'images', 'specs', 
               'location', 'city', 'area', 'condition', 'make', 'model', 
               'bedrooms', 'bathrooms', 'areaSize', 'areaUnit', 'transmission', 
               'fuelType', 'features', 'purpose', 'propertyType', 'type', 'year', 'mileage'
             ]) &&
             data.keys().hasAll(['id', 'seller', 'status', 'price', 'createdAt']) &&
             data.seller.uid == request.auth.uid &&
             data.status == 'pending' &&
             (!('isVerified' in data.seller) || data.seller.isVerified == false) &&
             (!('badgeType' in data.seller)) &&
             (!('verified_badge_type' in data.seller)) &&
             (!('badge' in data.seller)) &&
             data.price is number && data.price >= 0;
    }

    function isValidOwnerStatusTransition() {
      return (
        (existing().status == 'active' && incoming().status == 'inactive') ||
        (existing().status == 'inactive' && incoming().status == 'active') ||
        (existing().status == 'active' && incoming().status == 'sold') ||
        (existing().status == 'expired' && incoming().status == 'active')
      );
    }

    function isPropertyOwnerUpdate() {
      return isOwner(existing().seller.uid) &&
             incoming().seller.uid == existing().seller.uid &&
             incoming().diff(existing()).affectedKeys().hasOnly([
               'title', 'description', 'price', 'photos', 'images', 
               'specs', 'location', 'city', 'area', 'condition', 
               'make', 'model', 'bedrooms', 'bathrooms', 'areaSize', 
               'areaUnit', 'transmission', 'fuelType', 'features', 
               'updatedAt', 'purpose', 'propertyType', 'type', 'year', 'mileage',
               'status', 'last_confirmed_active', 'reactivated_at'
             ]) &&
             (
               (!('status' in incoming().diff(existing()).affectedKeys())) ||
               isValidOwnerStatusTransition()
             );
    }

    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidPropertyCreate(incoming()) && propertyId == incoming().id;
      allow update: if isSignedIn() && (
        isPropertyOwnerUpdate() ||
        (
          // Public viewer view/favorite counter increment with limits
          incoming().diff(existing()).affectedKeys().hasOnly(['views', 'favorites']) &&
          (!('views' in incoming().diff(existing()).affectedKeys()) || (incoming().views is number && incoming().views <= existing().views + 10 && incoming().views >= existing().views)) &&
          (!('favorites' in incoming().diff(existing()).affectedKeys()) || (incoming().favorites is number && incoming().favorites <= existing().favorites + 1 && incoming().favorites >= existing().favorites - 1))
        ) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (isOwner(existing().seller.uid) || isAdmin());
    }

    // ---------------------------------------------------------
    // Categories & Fields
    // ---------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /category_fields/{fieldId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /category_versions/{versionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // Notifications
    // ---------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin()); 
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // Conversations & Messages (participantIds immutable)
    // ---------------------------------------------------------
    match /conversations/{convId} {
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in incoming().participantIds) && convId == incoming().id;
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin()) &&
                    incoming().participantIds == existing().participantIds;
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds.hasAny([request.auth.uid]) || isAdmin());
        allow create: if isSignedIn() && (get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds.hasAny([request.auth.uid])) &&
                      incoming().senderId == request.auth.uid;
      }
    }

    // ---------------------------------------------------------
    // Service Requests & Other Collections
    // ---------------------------------------------------------
    match /financing_requests/{requestId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }
    match /insurance_requests/{requestId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }
    match /inspection_requests/{requestId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().reviewerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /security_alerts/{alertId} {
      allow read, write: if isAdmin();
    }

    // audit_logs: admin/server only
    match /audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /insurance_companies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /inspection_companies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /financing_companies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /auction_companies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /popular_styles/{styleId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // saved_searches create: userId must equal auth.uid
    match /saved_searches/{searchId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------
    // Ads Configurations: ad updates require sign-in; hasOnly with increment limit
    // ---------------------------------------------------------
    match /ads_configurations/{adId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isSignedIn() && (
        isAdmin() ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['views', 'clicks']) &&
          incoming().diff(existing()).affectedKeys().size() <= 2 &&
          (!('views' in incoming().diff(existing()).affectedKeys()) || (incoming().views is number && incoming().views <= existing().views + 10 && incoming().views >= existing().views)) &&
          (!('clicks' in incoming().diff(existing()).affectedKeys()) || (incoming().clicks is number && incoming().clicks <= existing().clicks + 2 && incoming().clicks >= existing().clicks)) &&
          incoming().id == existing().id &&
          incoming().status == existing().status &&
          incoming().title == existing().title &&
          incoming().imageUrl == existing().imageUrl
        )
      );
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // Reels: video create only for verified users (identity or business);
    // require status 'pending_review', counters 0, no featured flags;
    // hasOnly on counters with increment limit on update.
    // ---------------------------------------------------------
    function isValidReelCreate(data) {
      return data.sellerId == request.auth.uid &&
             data.status == 'pending_review' &&
             (!('viewsCount' in data) || data.viewsCount == 0) &&
             (!('likesCount' in data) || data.likesCount == 0) &&
             (!('commentsCount' in data) || data.commentsCount == 0) &&
             (!('isFeatured' in data) || data.isFeatured == false) &&
             (!('featuredUntil' in data));
    }

    match /reels/{reelId} {
      allow read: if true;
      allow create: if isVerifiedUser() && isValidReelCreate(incoming());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (existing().sellerId == request.auth.uid && incoming().sellerId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'caption', 'tags', 'propertyId', 'thumbnailUrl', 'updatedAt'])) ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['likesCount', 'commentsCount', 'viewsCount']) &&
          incoming().sellerId == existing().sellerId &&
          (!('viewsCount' in incoming().diff(existing()).affectedKeys()) || (incoming().viewsCount is number && incoming().viewsCount <= existing().viewsCount + 10 && incoming().viewsCount >= existing().viewsCount)) &&
          (!('likesCount' in incoming().diff(existing()).affectedKeys()) || (incoming().likesCount is number && incoming().likesCount <= existing().likesCount + 1 && incoming().likesCount >= existing().likesCount)) &&
          (!('commentsCount' in incoming().diff(existing()).affectedKeys()) || (incoming().commentsCount is number && incoming().commentsCount <= existing().commentsCount + 1 && incoming().commentsCount >= existing().commentsCount))
        )
      );
      allow delete: if isSignedIn() && (existing().sellerId == request.auth.uid || isAdmin());
    }

    match /reels_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /reels_likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /reels_saves/{saveId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /reels_offers/{offerId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/reels/$(resource.data.reelId)).data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow update: if isSignedIn() && (
        (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['priceOffer', 'notes', 'status']) && incoming().status in ['pending', 'cancelled']) ||
        (get(/databases/$(database)/documents/reels/$(existing().reelId)).data.sellerId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status']) && incoming().status in ['accepted', 'rejected', 'pending']) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------
    // Property Videos: create only for verified users (identity or business);
    // require status 'pending_review', counters 0, no featured flags;
    // hasOnly with increment limit on update.
    // ---------------------------------------------------------
    function isValidPropertyVideoCreate(data) {
      return data.creatorId == request.auth.uid &&
             data.status == 'pending_review' &&
             (!('viewsCount' in data) || data.viewsCount == 0) &&
             (!('likesCount' in data) || data.likesCount == 0) &&
             (!('sharesCount' in data) || data.sharesCount == 0) &&
             (!('savesCount' in data) || data.savesCount == 0) &&
             (!('listingClicksCount' in data) || data.listingClicksCount == 0) &&
             (!('isFeatured' in data) || data.isFeatured == false) &&
             (!('featuredUntil' in data));
    }

    match /property_videos/{videoId} {
      allow read: if true;
      allow create: if isVerifiedUser() && isValidPropertyVideoCreate(incoming());
      allow update: if isSignedIn() && (
        isAdmin() ||
        (existing().creatorId == request.auth.uid && incoming().creatorId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['title', 'caption', 'tags', 'propertyId', 'thumbnailUrl', 'overlaySpec', 'trimRange', 'updatedAt'])) ||
        (
          incoming().diff(existing()).affectedKeys().hasOnly(['viewsCount', 'likesCount', 'sharesCount', 'savesCount', 'listingClicksCount', 'watchTimeTotalSeconds']) &&
          incoming().creatorId == existing().creatorId &&
          incoming().status == existing().status &&
          (!('viewsCount' in incoming().diff(existing()).affectedKeys()) || (incoming().viewsCount is number && incoming().viewsCount <= existing().viewsCount + 10 && incoming().viewsCount >= existing().viewsCount)) &&
          (!('likesCount' in incoming().diff(existing()).affectedKeys()) || (incoming().likesCount is number && incoming().likesCount <= existing().likesCount + 1 && incoming().likesCount >= existing().likesCount)) &&
          (!('sharesCount' in incoming().diff(existing()).affectedKeys()) || (incoming().sharesCount is number && incoming().sharesCount <= existing().sharesCount + 1 && incoming().sharesCount >= existing().sharesCount)) &&
          (!('savesCount' in incoming().diff(existing()).affectedKeys()) || (incoming().savesCount is number && incoming().savesCount <= existing().savesCount + 1 && incoming().savesCount >= existing().savesCount)) &&
          (!('listingClicksCount' in incoming().diff(existing()).affectedKeys()) || (incoming().listingClicksCount is number && incoming().listingClicksCount <= existing().listingClicksCount + 1 && incoming().listingClicksCount >= existing().listingClicksCount))
        )
      );
      allow delete: if isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin());
    }

    // ---------------------------------------------------------
    // Video Reports: Sign-in required
    // ---------------------------------------------------------
    match /video_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && incoming().reporterId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    match /video_platform_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // Admins Collection: NOT readable by normal users
    // ---------------------------------------------------------
    match /admins/{adminId} {
      allow read: if isAdmin();
      allow write: if false;
    }

    // Health / Connection verification
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
