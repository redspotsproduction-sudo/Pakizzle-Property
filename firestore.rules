rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // ---------------------------------------------------------
    // Global Safety Net
    // ---------------------------------------------------------
    match /{document=**} { allow read, write: if false; }

    // ---------------------------------------------------------
    // Global Helpers
    // ---------------------------------------------------------
    function isSignedIn() { return request.auth != null; }
    
    function isAdmin() { 
      return isSignedIn() && request.auth.token.email_verified == true && (
        request.auth.token.email == 'redspotsproduction@gmail.com' ||
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) && 
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }
    
    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }
    
    function isValidId(id) { 
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$'); 
    }

    function incoming() { return request.resource.data; }
    function existing() { return resource.data; }

    // ---------------------------------------------------------
    // Public Profiles (Sanitized, non-PII, public display)
    // ---------------------------------------------------------
    match /publicProfiles/{userId} {
      allow read: if true;
      allow create, update: if isSignedIn() && (request.auth.uid == userId || isAdmin());
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // Users & Private Profiles
    // ---------------------------------------------------------
    function isValidUser(data) {
      return data.keys().hasAll(['uid', 'email', 'status', 'role']) &&
             data.uid == request.auth.uid &&
             data.email is string &&
             data.status in ['active', 'suspended', 'banned', 'pending'] &&
             data.role in ['user', 'moderator', 'finance', 'support'] &&
             (!('isVerified' in data) || data.isVerified == false) &&
             (!('verificationLevel' in data) || data.verificationLevel == 0) &&
             (!('isPhoneVerified' in data) || data.isPhoneVerified == false) &&
             (!('isEmailVerified' in data) || data.isEmailVerified == false) &&
             (!('isOtpVerified' in data) || data.isOtpVerified == false) &&
             (!('identity_status' in data) || data.identity_status != 'verified') &&
             (!('verified_badge_type' in data) || data.verified_badge_type == 'none');
    }

    match /users/{userId} {
      // Readable by owner and admin only (PII Isolation)
      allow read: if isOwner(userId) || isAdmin(); 
      allow create: if isSignedIn() && isValidUser(incoming()) && userId == request.auth.uid;
      
      // Action: Profile Update (Restricted non-sensitive profile customization)
      function isProfileUpdate() {
        return incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'photoURL', 'username',
          'isOnline', 'lastSeen', 'notificationSettings', 'dob', 
          'nationality', 'gender', 'updatedAt', 'rating', 'ratingCount',
          'themePreference', 'bio', 'city', 'address', 'agencyName', 'agencyLicense'
        ]);
      }

      // Action: Onboarding Initial State Transition with Strict Field Allowlist
      function isTransitioningOnboarding() {
        return (
          !('onboardingCompletedAt' in existing()) || 
          (existing().isPendingOnboarding == true) || 
          existing().status == 'pending'
        ) && 
        incoming().role == 'user' &&
        (
          (!('accountType' in incoming()) || incoming().accountType == 'user' && incoming().status == 'active') ||
          (incoming().accountType in ['dealer', 'company'] && incoming().status == 'pending')
        ) &&
        incoming().diff(existing()).affectedKeys().hasOnly([
          'displayName', 'username', 'photoURL', 'accountType', 'agencyName', 
          'agencyLicense', 'city', 'address', 'operatingSystem', 'browser', 
          'device', 'registrationSource', 'trustScore', 'riskScore', 'riskLevel', 
          'suspiciousActivityCount', 'lastLoginAt', 'isOnline', 'lastSeen', 
          'isPendingOnboarding', 'onboardingCompletedAt', 'updatedAt', 'status', 
          'role', 'lastKnownIp', 'ipHistory', 'bio'
        ]);
      }

      // Constraints enforcing that normal users cannot write identity_status='verified', verified_badge_type, role, or verification fields
      function isSafeUserSelfUpdate() {
        return isOwner(userId) &&
          // Normal user cannot change role
          (incoming().role == existing().role || (!('role' in incoming()) && !('role' in existing()))) &&
          // Normal user cannot make themselves admin
          (!('role' in incoming()) || incoming().role != 'admin' || existing().role == 'admin') &&
          // Normal user cannot self-grant isVerified
          (!('isVerified' in incoming()) || incoming().isVerified == existing().isVerified) &&
          // Normal user cannot self-grant identity_status == 'verified'
          (!('identity_status' in incoming()) || incoming().identity_status == existing().identity_status) &&
          // Normal user cannot self-grant verificationLevel
          (!('verificationLevel' in incoming()) || incoming().verificationLevel == existing().verificationLevel) &&
          // Normal user cannot self-grant phone/email verification
          (!('isPhoneVerified' in incoming()) || incoming().isPhoneVerified == existing().isPhoneVerified) &&
          (!('isEmailVerified' in incoming()) || incoming().isEmailVerified == existing().isEmailVerified) &&
          (!('isOtpVerified' in incoming()) || incoming().isOtpVerified == existing().isOtpVerified) &&
          // Normal user cannot self-grant verified_badge_type
          (!('verified_badge_type' in incoming()) || incoming().verified_badge_type == existing().verified_badge_type) &&
          // Normal user cannot self-grant badgeType
          (!('badgeType' in incoming()) || incoming().badgeType == existing().badgeType);
      }

      allow update: if isSignedIn() && (
        (isOwner(userId) && 
         (
           isProfileUpdate() ||
           isTransitioningOnboarding()
         ) &&
         isSafeUserSelfUpdate()
        ) || isAdmin()
      );
      
      match /addresses/{addressId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
      
      match /payment_methods/{methodId} {
        allow read, write: if isOwner(userId) || isAdmin();
      }
    }

    // ---------------------------------------------------------
    // Verification Requests
    // ---------------------------------------------------------
    match /verification_requests/{requestId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow update: if isAdmin();
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // Properties & Listings
    // ---------------------------------------------------------
    match /properties/{propertyId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidVehicle(incoming()) && propertyId == incoming().id;
      allow update: if isSignedIn() && (
        (isOwner(existing().seller.uid) && 
         incoming().seller.uid == existing().seller.uid &&
         (!('title_deed_status' in incoming()) || incoming().title_deed_status == existing().title_deed_status)
        ) || isAdmin()
      );
      allow delete: if isSignedIn() && (isOwner(existing().seller.uid) || isAdmin());
    }

    // ---------------------------------------------------------
    // Categories & Fields
    // ---------------------------------------------------------
    match /categories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /category_fields/{fieldId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    match /category_versions/{versionId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------
    // Vehicles / Legacy listings
    // ---------------------------------------------------------
    function isValidVehicle(data) {
      return data.keys().hasAll(['id', 'make', 'model', 'price', 'seller', 'status', 'createdAt']) &&
             data.seller.uid == request.auth.uid &&
             data.price is number && data.price >= 0;
    }

    match /vehicles/{vehicleId} {
      allow read: if true;
      allow create: if isSignedIn() && isValidVehicle(incoming()) && vehicleId == incoming().id;
      allow update: if isSignedIn() && (
        (isOwner(existing().seller.uid) && 
         incoming().seller.uid == existing().seller.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['make', 'model', 'year', 'price', 'mileage', 'location', 'city', 'area', 'images', 'type', 'category', 'condition', 'transmission', 'fuelType', 'engineSize', 'specs', 'features', 'description', 'status', 'updatedAt', 'isAuctionVerified', 'isFeatured', 'featuredUntil', 'views', 'favorites', 'badges', 'propertyType'])
        ) || isAdmin()
      );
      allow delete: if isSignedIn() && (isOwner(existing().seller.uid) || isAdmin());
    }

    // ---------------------------------------------------------
    // Notifications
    // ---------------------------------------------------------
    match /notifications/{notificationId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || isAdmin()); 
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin()) && 
                    incoming().diff(existing()).affectedKeys().hasOnly(['status']);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------
    // Conversations
    // ---------------------------------------------------------
    match /conversations/{convId} {
      allow read: if isSignedIn() && (resource == null || request.auth.uid in resource.data.participantIds || isAdmin());
      allow create: if isSignedIn() && (request.auth.uid in incoming().participantIds) && convId == incoming().id;
      allow update: if isSignedIn() && (request.auth.uid in resource.data.participantIds || isAdmin());
      
      match /messages/{messageId} {
        allow read: if isSignedIn() && (get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds.hasAny([request.auth.uid]) || isAdmin());
        allow create: if isSignedIn() && (get(/databases/$(database)/documents/conversations/$(convId)).data.participantIds.hasAny([request.auth.uid])) &&
                      incoming().senderId == request.auth.uid;
      }
    }

    // ---------------------------------------------------------
    // Service Requests & Other Collections
    // ---------------------------------------------------------
    match /financing_requests/{requestId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }
    match /insurance_requests/{requestId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }
    match /inspection_requests/{requestId} {
      allow read, write: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
    }
    match /reviews/{reviewId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().reviewerId == request.auth.uid;
      allow update, delete: if isAdmin();
    }
    match /security_alerts/{alertId} {
      allow read, write: if isAdmin();
    }
    match /audit_logs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn();
    }
    match /banners/{bannerId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /insurance_companies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /inspection_companies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /financing_companies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /auction_companies/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /popular_styles/{styleId} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /saved_searches/{searchId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && (incoming().userId == request.auth.uid || request.auth.uid != null);
      allow update: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
    match /ads_configurations/{adId} {
      allow read: if true;
      allow create: if isAdmin();
      allow update: if isAdmin() || (
        incoming().diff(existing()).affectedKeys().hasAny(['views', 'clicks']) &&
        incoming().diff(existing()).affectedKeys().size() <= 2 &&
        incoming().id == existing().id &&
        incoming().status == existing().status &&
        incoming().title == existing().title &&
        incoming().imageUrl == existing().imageUrl
      );
      allow delete: if isAdmin();
    }
    match /reels/{reelId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().sellerId == request.auth.uid;
      allow update: if isSignedIn() && (
        (existing().sellerId == request.auth.uid && incoming().sellerId == request.auth.uid) ||
        (incoming().diff(existing()).affectedKeys().hasAny(['likesCount', 'commentsCount', 'viewsCount']) &&
         incoming().diff(existing()).affectedKeys().size() <= 3) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (existing().sellerId == request.auth.uid || isAdmin());
    }

    match /reels_comments/{commentId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isSignedIn() && existing().userId == request.auth.uid && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /reels_likes/{likeId} {
      allow read: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /reels_saves/{saveId} {
      allow read: if isSignedIn() && (resource == null || resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    match /reels_offers/{offerId} {
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.userId == request.auth.uid ||
        get(/databases/$(database)/documents/reels/$(resource.data.reelId)).data.sellerId == request.auth.uid ||
        isAdmin()
      );
      allow create: if isSignedIn() && incoming().userId == request.auth.uid && incoming().status == 'pending';
      allow update: if isSignedIn() && (
        (existing().userId == request.auth.uid && incoming().diff(existing()).affectedKeys().hasOnly(['priceOffer', 'notes', 'status'])) ||
        (get(/databases/$(database)/documents/reels/$(existing().reelId)).data.sellerId == request.auth.uid &&
         incoming().diff(existing()).affectedKeys().hasOnly(['status'])) ||
        isAdmin()
      );
      allow delete: if isSignedIn() && (existing().userId == request.auth.uid || isAdmin());
    }

    match /property_videos/{videoId} {
      allow read: if true;
      allow create: if isSignedIn();
      allow update: if isSignedIn() && (
        isAdmin() ||
        (existing().creatorId == request.auth.uid && incoming().creatorId == request.auth.uid) ||
        (incoming().diff(existing()).affectedKeys().hasAny(['viewsCount', 'likesCount', 'sharesCount', 'savesCount', 'listingClicksCount', 'watchTimeTotalSeconds']))
      );
      allow delete: if isSignedIn() && (existing().creatorId == request.auth.uid || isAdmin());
    }

    match /video_reports/{reportId} {
      allow read: if isAdmin();
      allow create: if true;
      allow update, delete: if isAdmin();
    }

    match /video_platform_settings/{settingId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if false;
    }

    // Health / Connection verification
    match /test/{testId} {
      allow read: if true;
      allow write: if false;
    }
  }
}
